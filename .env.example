# Discord Developer Portal → Applications → Bot → Token
DISCORD_TOKEN=your_discord_bot_token_here

# (선택) 슬래시 명령어를 특정 서버에 즉시 동기화할 때 사용
# Discord → 서버 설정 → 위젯 / 개발자 모드 → 서버 ID 복사
# 설정 시 활동 집계·REST API 접근도 해당 서버로 제한됩니다.
GUILD_ID=

# REST API 인증 키 (Authorization: Bearer <API_KEY>)
# python src/main.py 로 봇+API를 함께 띄울 때 필요합니다.
API_KEY=

# REST API 포트 (Railway는 PORT를 자동 주입합니다)
PORT=8000

# (선택) 활동 데이터 파일 경로. Railway Volume 사용 시 예: /data/activity.json
# ACTIVITY_FILE=

# (선택) TFT 패치·소식 상태 파일 경로. Railway Volume 사용 시 예: /data/tft_digest.json
# TFT_DIGEST_FILE=
# (선택) 공식 TFT 소식 확인 주기(분). 기본 30
# TFT_POLL_MINUTES=30

# (선택) Steam 할인 알림 상태 파일. Railway Volume 사용 시 예: /data/steam_digest.json
# STEAM_DIGEST_FILE=
# (선택) Steam 할인 확인 주기(분). 기본 60
# STEAM_POLL_MINUTES=60
# (선택) Steam 최소 할인율(%). /스팀알림설정으로도 변경 가능
# STEAM_MIN_DISCOUNT=50
# (선택) Steam 스토어 지역/언어. 기본 kr / korean
# STEAM_CC=kr
# STEAM_LANG=korean
# (선택) Steam 검색에서 가져올 할인 게임 수. 기본 100
# STEAM_SEARCH_COUNT=100
